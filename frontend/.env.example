# Frontend (Vite) variables. Copy to frontend/.env for `npm run dev`; Vite reads it only at startup.
# The local backend runs on http://localhost:8000 (see README.md).

VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Google Maps JavaScript API key for the map (browser key; the only map provider).
# Without it, the map shows "Map isn't available right now" and search/list still work.
# BEFORE REAL USERS: restrict this key in Google Cloud Console by HTTP referrer (localhost + the app's domain)
# and to the Maps JavaScript API only. Anyone can read a browser key from the page.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# (Old name VITE_GOOGLE_MAP_DEMO_KEY is still read for one release, with a warning.)

# Optional: a 3D satellite fly-over of the open trip's destination on the trip page (default off)
VITE_MAP_3D=false

# Optional: "Add to Itinerary" shows only within this many km of the open trip's destination (default 60).
# Keep it equal to TRIP_AREA_RADIUS_KM in backend/.env.
# VITE_TRIP_AREA_RADIUS_KM=60

# Voice step 1: temporary transcript test panel (true only while testing)
VITE_VOICE_TEST_TRANSCRIPT=false
