# Frontend (Vite) variables. Copy to frontend/.env for `npm run dev`; Vite reads it only at startup.
# The local backend runs on http://localhost:8000 (see README.md).

VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Optional: Google Maps key for the map demo
VITE_GOOGLE_MAP_DEMO_KEY=

# Voice step 1: temporary transcript test panel (true only while testing)
VITE_VOICE_TEST_TRANSCRIPT=false
