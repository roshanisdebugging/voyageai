# VoyageAI Backend Environment Configuration

# Active AI provider: openai (OpenAI first, Gemini as backup) | gemini | mock
# The tour guide chat always uses Gemini (Google Search grounding).
AI_PROVIDER=openai

# OpenAI (pay as you go). Create a key at https://platform.openai.com/api-keys and paste it below.
# Used for: voice speech-to-text, the voice agent, itinerary generation and the cost guard.
# Backend only: never put this key in frontend/.env (VITE_ values are public).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Jarvis chat (tour guide): which model answers first. openai (default) = OpenAI, Gemini as backup; gemini = old Gemini-only path.
TOURGUIDE_PRIMARY=openai
# The reasoning_effort value for models that take it (o-series, gpt-5*, gpt-oss*). gpt-4.1* never gets it.
OPENAI_REASONING_EFFORT=low
# Itinerary generation: read timeout for one OpenAI call, in seconds (connect timeout is a separate 10 s).
# A 6-day plan needs well over 30 s on gpt-4.1-mini. Other OpenAI calls keep their own shorter timeouts.
OPENAI_ITINERARY_TIMEOUT_S=90

# Groq: the ONLY fallback for itinerary generation (OpenAI -> Groq -> stop; Gemini is not used there).
# Without a key the fallback is skipped and a failed OpenAI call fails the itinerary cleanly.
GROQ_API_KEY=
# Must be a current Groq chat model with JSON mode (llama-3.3-70b-versatile was retired).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ITINERARY_TIMEOUT_S=60

# Cost guard classifier: openai (OpenAI, Gemini backup) | gemini | semantic
COST_GUARD_BACKEND=openai

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Vertex AI / GCP Configuration (Legacy / Production option)
SA_KEY_PATH=./keys/demos-others-89a2bdcf7612.json
PROJECT_ID=demos-others
LOCATION=us-central1
MODEL_NAME=meta/llama-3.3-70b-instruct-maas

# Google Maps SERVER key (Places, Geocoding v4, Routes). Never the browser key.
# Old names GOOGLE_MAPS_API_KEY / GOOGLE_MAP_DEMO_KEY are still read for one release, with a warning.
# Before real users: restrict it to the server's IP and to Places API (New), Geocoding API, Routes API.
GOOGLE_MAPS_SERVER_KEY=
# Place pictures from Google (image_service.py). Off: pictures come from Wikipedia / Wikimedia, then Pexels, else a
# placeholder, and no picture lookup calls Google. On: it shares Google's Text Search quota with voice place search
# (heavy picture use can pause voice search), and Google's photo terms apply: photos must not be stored or cached,
# and the photo credit must be shown.
GOOGLE_IMAGES_ENABLED=false
# When it is on, pictures use the same key: it needs "Places API (New)" enabled (Text Search with the
# photos field + Place Photos). Photos go through /api/place-photo, so the key never reaches the browser.
# Daily caps on those calls (Text Search for a picture / photo downloads through the proxy):
IMAGE_GOOGLE_DAILY_CAP=300
IMAGE_PHOTO_DAILY_CAP=1000

# Places farther than this from the trip's destination can't be added to its itinerary (km, default 60).
# Keep it equal to VITE_TRIP_AREA_RADIUS_KM in frontend/.env.
# TRIP_AREA_RADIUS_KM=60

# Optional: Pexels stock photos, ONLY for trip covers and broad categories (food, beach, market), never for a
# named landmark. Leave empty to skip Pexels (no error). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=
# User-Agent for Wikipedia / Wikimedia requests. Wikimedia allows only 10 requests/min without contact info and
# 200/min with it (https://www.mediawiki.org/wiki/Wikimedia_APIs/Rate_limits). Set it: app name + contact URL/email.
#   VoyageAI/1.0 (https://your-site.example/; contact@your-site.example) python-requests
WIKIMEDIA_USER_AGENT=

# Routes API result cache in seconds. Keep 0: Google's Service Specific Terms (section 19.3) allow caching only
# latitude/longitude from the Routes API, not distance, duration or the route line.
ROUTES_CACHE_TTL_S=0

# Extra websites allowed to call the API with login cookies (comma-separated).
# localhost dev ports and https://tour-guide-v1.netlify.app are always allowed.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API (0 when running directly on localhost).
# Used to read the real client IP for rate limits.
TRUSTED_PROXY_HOPS=0

# --- Voice (voicefirst.md step 1): speech to text on /ws/voice ---
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-transcribe
# VOICE_STT_LANGUAGES=hi,en   (unset = auto-detect the spoken language)
# VOICE_STT_PROMPT=   (unset = built-in Hinglish spelling hint; empty = no hint)
# Spoken reply (step 1b): Sarvam TTS
SARVAM_API_KEY=
VOICE_TTS_ENABLED=true
# Sarvam model: bulbul:v3 (default if unset) or bulbul:v4-flash (its voice IDs differ from v3's)
SARVAM_TTS_MODEL=bulbul:v4-flash
# The voice: a v3 name (ritu, rahul, ...) on bulbul:v3; on bulbul:v4-flash a v4 voice ID, sent exactly as written
VOICE_TTS_SPEAKER=aayan_hi_conversational
# Speaking speed, 0.5 to 2.0 (default 1.0 if unset)
SARVAM_TTS_PACE=1.05
# WAV sample rate in Hz: 8000, 16000, 22050 (default if unset), 24000, 32000, 44100 or 48000
SARVAM_TTS_SAMPLE_RATE=24000

# Test-only saving of recordings + transcripts (testing.md). LOCAL Postgres only; never set on a server.
VOICE_DEBUG_STORE=false
# VOICE_DEBUG_DATABASE_URL=postgresql://postgres:<local password>@localhost:5432/voice_test
# VOICE_DEBUG_AUDIO_DIR=test_audio_folder

# Booking stage 3: true = startup does NOT create the booking_requests table (keep it out of a shared database).
# SKIP_BOOKING_TABLE_CREATE=true
# Booking stage 4: true = each saved request is emailed to PARTNER_EMAIL (false = nothing sent, "not sent" wording).
# BOOKING_NOTIFY_ENABLED=false
# Partner email (booking_mail.py). SMTP over STARTTLS; for Gmail use an app password, never the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# PARTNER_EMAIL=
# Hours the customer is told the partner will call within (shown only once the email is sent).
# BOOKING_REPLY_HOURS=2
