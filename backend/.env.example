# VoyageAI Backend Environment Configuration

# Active AI provider: groq (Groq first, Gemini as backup) | gemini | mock
# The tour guide chat always uses Gemini (Google Search grounding).
AI_PROVIDER=groq

# Groq (https://console.groq.com). Free tier ~8,000 tokens/min for the whole account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cost guard classifier: groq (Groq, Gemini backup) | gemini | semantic
COST_GUARD_BACKEND=groq

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Vertex AI / GCP Configuration (Legacy / Production option)
SA_KEY_PATH=./keys/demos-others-89a2bdcf7612.json
PROJECT_ID=demos-others
LOCATION=us-central1
MODEL_NAME=meta/llama-3.3-70b-instruct-maas
GOOGLE_MAPS_API_KEY=

# Extra websites allowed to call the API with login cookies (comma-separated).
# localhost dev ports and https://tour-guide-v1.netlify.app are always allowed.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API (0 when running directly on localhost).
# Used to read the real client IP for rate limits.
TRUSTED_PROXY_HOPS=0

# --- Voice (voicefirst.md step 1): speech to text on /ws/voice ---
VOICE_STT_PROVIDER=groq
VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_STT_PROMPT=   (unset = built-in Hinglish spelling hint; empty = no hint)

# Test-only saving of recordings + transcripts (testing.md). LOCAL Postgres only; never set on a server.
VOICE_DEBUG_STORE=false
# VOICE_DEBUG_DATABASE_URL=postgresql://postgres:<local password>@localhost:5432/voice_test
# VOICE_DEBUG_AUDIO_DIR=test_audio_folder
