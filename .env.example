# docker-compose variables (copy to .env at the repo root when using docker compose).
# Frontend dev variables live in frontend/.env.example; backend ones in backend/.env.example.

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=cruiser_db
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/cruiser_db

# Backend Configuration
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5248

# Frontend Configuration (Used during Docker build)
VITE_API_BASE_URL=http://localhost:80

